    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: Test runregistar --operation stack RGB",
            "type": "debugpy",
            "request": "launch",
            "program": "./src/runregistar/runregistar.py",
            "console": "integratedTerminal",
            "args": "--operation stack ./Tests/RGB/C59A166[2-9].tif ./Tests/RGB/C59A167[0-9].tif"
        },
        {
            "name": "Python Debugger: Test runregistar --operation stack H-alpha",
            "type": "debugpy",
            "request": "launch",
            "program": "./src/runregistar/runregistar.py",
            "console": "integratedTerminal",
            "args": "--operation stack ./Tests/H-alpha/C59A168[1-9].tif ./Tests/H-alpha/C59A169[0-2].tif"
        },
        {
            "name": "Python Debugger: Test runregistar --operation stack RGB 2,3,3,3,3,3",
            "type": "debugpy",
            "request": "launch",
            "program": "./src/runregistar/runregistar.py",
            "console": "integratedTerminal",
            "args": "--operation stack ./Tests/RGB/C59A166[3-9].tif ./Tests/RGB/C59A167[0-9].tif"
        },
        {
            "name": "Python Debugger: Test runregistar --operation stack RGB 3,3,3,3,3,2",
            "type": "debugpy",
            "request": "launch",
            "program": "./src/runregistar/runregistar.py",
            "console": "integratedTerminal",
            "args": "--operation stack ./Tests/RGB/C59A166[2-9].tif ./Tests/RGB/C59A167[0-8].tif"
        },
        {
            "name": "Python Debugger: Test runregistar --operation register",
            "type": "debugpy",
            "request": "launch",
            "program": "./src/runregistar/runregistar.py",
            "console": "integratedTerminal",
            "args": "--operation register ./Tests/C59A1662-C59A1664_stacked_pano_miller.tif ./Tests/C59A1681-C59A1682_stacked_pano_miller.tif"
        }
    ]
}